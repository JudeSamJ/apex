# Example environment configuration for the Apex backend.
#
# Copy to `backend/.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real credentials.
#
# In production, prefer a real secrets manager over this file: set
# SECRETS_PROVIDER=vault (see app/secrets/provider.py) and leave the
# sensitive values below unset.

# ---------------------------------------------------------------- core app
# Omit to default to local SQLite (sqlite:///./ramp_clone.db).
# For Postgres/Neon, use the bare connection URL — no `psql '...'` wrapper.
# app/database.py rewrites postgres:// and postgresql:// to
# postgresql+psycopg:// (this app ships psycopg3, not psycopg2).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Signing key for access tokens and password-reset tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Extra browser origins allowed to call this API, comma-separated, no trailing
# slash. localhost:5173 / 127.0.0.1:5173 are always allowed, so this is only
# needed for deployed frontends:
#   CORS_ORIGINS=https://apex-ten-phi.vercel.app
CORS_ORIGINS=
# Optional regex for preview deployments, whose URL changes per commit. Anchor
# it to your own project prefix — a bare .*\.vercel\.app would let any page on
# any Vercel account call this API with credentials.
#   CORS_ORIGIN_REGEX=https://apex-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# Whether app startup runs `alembic upgrade head`. Leave on locally. Turn it
# off on serverless hosts, where every cold start would otherwise re-check
# migrations before serving, and concurrent cold starts race each other; apply
# migrations as a deploy step instead.
RUN_MIGRATIONS_ON_STARTUP=true
AUTO_APPROVE_ONBOARDING=False
LOG_LEVEL=INFO

# ------------------------------------------------------- redis / background
# Backs rate limiting and Celery. Unset falls back to in-memory rate limiting.
REDIS_URL=

# ----------------------------------------------------------- secrets manager
# "env" (default) reads this file; "vault" reads HashiCorp Vault instead.
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=apex
VAULT_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------- issuing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------- payment rail
DWOLLA_APP_KEY=
DWOLLA_APP_SECRET=
DWOLLA_WEBHOOK_SECRET=

# ------------------------------------------------------------ bank linking
PLAID_CLIENT_ID=
PLAID_SECRET=

# -------------------------------------------------------------------- KYC
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# --------------------------------------------------------- sanctions / AML
COMPLYADVANTAGE_API_KEY=

# ---------------------------------------------------------------- FX rates
EXCHANGE_RATE_API_KEY=

# --------------------------------------------------------------- accounting
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:5173/qbo-callback

# --------------------------------------------------------------------- SSO
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ------------------------------------------------------------------- email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

# --------------------------------------------------------- observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# ------------------------------------ toggle real integrations on/off
# All False = every external integration runs against its in-repo stub.
USE_REAL_ISSUING=False
USE_REAL_PAYMENT_RAIL=False
USE_REAL_PLAID=False
USE_REAL_DIDIT=False
USE_REAL_QBO=False
USE_REAL_SSO=False
USE_REAL_EMAIL=False
USE_REAL_FX=False
USE_REAL_SCREENING=False
