# Copy to frontend/.env.local for local development, or set these in your
# host's environment-variables UI for a deployed build.
#
# Vite only exposes variables prefixed with VITE_ to client code, and it
# INLINES them at build time. Changing this on the host does not affect an
# existing deployment — the frontend must be rebuilt for a new value to
# take effect.

# Base URL of the backend API, no trailing slash.
# Local default when unset: http://localhost:8000
VITE_API_BASE=https://apex-backend-rouge.vercel.app
